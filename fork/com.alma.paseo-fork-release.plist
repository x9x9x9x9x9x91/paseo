<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by fork/install.sh, which fills in __HOME__ and __ROOT__. The tools clone
     follows fork/release, so a landed change to the job runs from the next hour on. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alma.paseo-fork-release</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>cd __ROOT__/tools &amp;&amp; git fetch -q --depth 1 origin fork/release &amp;&amp; git checkout -q -f --detach FETCH_HEAD; exec caffeinate -i /opt/homebrew/bin/node __ROOT__/tools/fork/release.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/paseo-fork-release.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/paseo-fork-release.log</string>
</dict>
</plist>
